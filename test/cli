pass "fallback commands are inferred and documented"

"$CLI" commands --all --json | jq -e '.commands[] | select(.route == "doxia dev benchmark cli")' >/dev/null
pass "benchmark command is discoverable in all commands"

"$CLI" commands --json | jq -e '.commands[] | select(.binary == "doxia-pkg-add" and .route == "doxia pkg add" and .filename_route == "doxia pkg add" and (.routes | index("doxia pkg add")))' >/dev/null
pass "JSON exposes direct pkg add route"

"$CLI" commands --json | jq -e '.commands[] | select(.binary == "doxia-install-gaming-xbox-cloud" and .route == "doxia install gaming xbox-cloud" and .filename_route == "doxia install gaming xbox cloud" and (.routes | index("doxia install gaming xbox cloud")))' >/dev/null
pass "Xbox Cloud installer keeps hyphenated canonical route"

"$CLI" commands --json | jq -e '.commands[] | select(.binary == "doxia-install-gaming-xbox-controllers" and .route == "doxia install gaming xbox-controllers" and .filename_route == "doxia install gaming xbox controllers" and (.routes | index("doxia install gaming xbox controllers")))' >/dev/null
pass "Xbox controller installer keeps hyphenated canonical route"

"$CLI" commands --json | jq -e '.commands[] | select(.binary == "doxia-remove-gaming-xbox-controllers" and .route == "doxia remove gaming xbox-controllers" and .filename_route == "doxia remove gaming xbox controllers" and (.routes | index("doxia remove gaming xbox controllers")))' >/dev/null
pass "Xbox controller remover keeps hyphenated canonical route"

"$CLI" commands --json | jq -e '.commands[] | select(.binary == "doxia-install-gaming-geforce-now" and .route == "doxia install gaming geforce-now" and .filename_route == "doxia install gaming geforce now" and (.routes | index("doxia install gaming geforce now")))' >/dev/null
pass "GeForce NOW installer keeps hyphenated canonical route"

"$CLI" commands --json | jq -e '.commands[] | select(.binary == "doxia-remove-gaming-geforce-now" and .route == "doxia remove gaming geforce-now" and .filename_route == "doxia remove gaming geforce now" and (.routes | index("doxia remove gaming geforce now")))' >/dev/null
pass "GeForce NOW remover keeps hyphenated canonical route"

"$CLI" commands --json | jq -e '.commands[] | select(.binary == "doxia-install-gaming-gpu-lib32" and .route == "doxia install gaming gpu-lib32" and .filename_route == "doxia install gaming gpu lib32" and (.routes | index("doxia install gaming gpu lib32")))' >/dev/null
pass "GPU lib32 installer keeps hyphenated canonical route"

