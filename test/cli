jq -e '.contributes.themes[0].uiTheme == "vs"' "$PI_TMPDIR/.vscode/extensions/doxia-theme/package.json" >/dev/null || fail "vscode generated light theme uses VS Code light uiTheme"
pass "vscode generated light theme uses VS Code light uiTheme"
[[ -L $PI_TMPDIR/.vscode/extensions/doxia-theme/themes/doxia-color-theme.json ]] || fail "vscode generated theme references current theme file"
[[ $(readlink "$PI_TMPDIR/.vscode/extensions/doxia-theme/themes/doxia-color-theme.json") == "$PI_TMPDIR/.local/state/doxia/current/theme/vscode-theme.json" ]] || fail "vscode generated theme references current theme file"
pass "vscode generated theme references current theme file"
[[ ! -f $PI_TMPDIR/.vscode/extensions/.obsolete ]] || fail "vscode generated theme clears obsolete extension marker"
pass "vscode generated theme clears obsolete extension marker"
jq -e '.[] | select(.identifier.id == "local.doxia-theme" and .relativeLocation == "doxia-theme")' "$PI_TMPDIR/.vscode/extensions/extensions.json" >/dev/null || fail "vscode generated theme registers local extension"
pass "vscode generated theme registers local extension"

for binary in \
  doxia-update \
  doxia-theme-set \
  doxia-capture-screenshot \
  doxia-system-reboot \
  doxia-pkg-add; do
  [[ -x $ROOT/bin/$binary ]] || fail "binary is executable: $binary"
  pass "binary is executable: $binary"
done

while IFS= read -r binary_path; do
  header=$(awk '
    NR == 1 && /^#!/ { next }
    /^[[:space:]]*$/ { if (seen) print; next }
    /^[[:space:]]*#/ { seen=1; print; next }
    { exit }
  ' "$binary_path")

  grep -q '^# doxia:summary=' <<<"$header" || fail "metadata summary is present: $binary_path"
  ! grep -q '^# doxia:binary=' <<<"$header" || fail "metadata does not repeat inferred binary: $binary_path"
  ! grep -q '^# doxia:args=$' <<<"$header" || fail "metadata does not include empty args: $binary_path"
  ! grep -Eq '^# doxia:(legacy|usage|visibility|mutates|interactive)=' <<<"$header" || fail "metadata avoids removed fields: $binary_path"
  ! grep -Eq '^# doxia:requires-sudo=false$' <<<"$header" || fail "metadata omits false booleans: $binary_path"
done < <(find "$ROOT/bin" -maxdepth 1 -type f -executable -name 'doxia-*' | sort)
pass "all executable bins have slim self-documenting metadata"

make_tmpdir TMPDIR
ln -s "$CLI" "$TMPDIR/doxia"

{
  printf '#!/bin/bash\n\n'
  printf '# ordinary comments are fine\n'
  printf '# doxia:this malformed line should be ignored\n'
  printf '# doxia:group=weird\n'
  printf '# doxia:name=test\n'
  printf '# doxia:summary=Survives malformed metadata comments\n'
  printf '# doxia:made-up=value\n'
  printf 'echo weird-ok\n'
} >"$TMPDIR/doxia-weird-test"
chmod +x "$TMPDIR/doxia-weird-test"

{
  printf '#!/bin/bash\n\n'
  printf '# a partial metadata header should not destroy fallback routing\n'
  printf '# doxia:summary=Partial metadata keeps inferred route\n'
  printf '# doxia:made-up=value\n'
  printf 'echo partial-ok\n'
} >"$TMPDIR/doxia-partial-meta-test"
chmod +x "$TMPDIR/doxia-partial-meta-test"

{
  printf '#!/bin/bash\n\n'
  printf 'echo body-metadata-ok\n'
  printf '# doxia:group=wrong\n'
  printf '# doxia:name=wrong\n'
} >"$TMPDIR/doxia-body-metadata-test"
chmod +x "$TMPDIR/doxia-body-metadata-test"

"$TMPDIR/doxia" commands --all --json | jq -e '.commands[] | select(.route == "doxia weird test" and .summary == "Survives malformed metadata comments")' >/dev/null
pass "unknown metadata values are non-fatal"

"$TMPDIR/doxia" commands --all --json | jq -e '.commands[] | select(.route == "doxia partial meta test" and .summary == "Partial metadata keeps inferred route")' >/dev/null
pass "partial metadata keeps inferred fallback route"

"$TMPDIR/doxia" commands --all --json | jq -e '.commands[] | select(.route == "doxia body metadata test" and .summary == "Run the body metadata test command")' >/dev/null
pass "metadata-looking comments after script body are ignored"

output=$("$TMPDIR/doxia" weird test)
assert_output_contains "temporary metadata command dispatches" "$output" "weird-ok"

output=$("$TMPDIR/doxia" partial meta test)
assert_output_contains "partial metadata command dispatches" "$output" "partial-ok"

output=$("$TMPDIR/doxia" body metadata test)
assert_output_contains "body metadata command dispatches by filename" "$output" "body-metadata-ok"

# A trailing --help must render help even when the route only partially
# resolves, leaving unresolved words ahead of the flag (e.g. `update aur --help`
# used to start a real update because only the first leftover token was checked).
{
  printf '#!/bin/bash\n\n'
  printf '# doxia:summary=Partial resolution help test parent\n'
  printf '# doxia:alias=doxia parenthelp-alias\n'
  printf 'echo "parenthelp-parent-ran args=[$*]"\n'
} >"$TMPDIR/doxia-parenthelp"
chmod +x "$TMPDIR/doxia-parenthelp"

{
  printf '#!/bin/bash\n\n'
  printf '# doxia:summary=Partial resolution help test child\n'
  printf 'echo parenthelp-child-ran\n'
} >"$TMPDIR/doxia-parenthelp-child"
chmod +x "$TMPDIR/doxia-parenthelp-child"

output=$("$TMPDIR/doxia" parenthelp bogus --help)
assert_output_contains "trailing --help after an unresolved word renders help" "$output" "doxia-parenthelp"
assert_output_contains "partial resolution help lists related commands" "$output" "doxia parenthelp child"
if [[ $output == *"parenthelp-parent-ran"* ]]; then
  fail "trailing --help after an unresolved word does not execute the command"
fi
pass "trailing --help after an unresolved word does not execute the command"

output=$("$TMPDIR/doxia" parenthelp bogus -h)
assert_output_contains "trailing -h after an unresolved word renders help" "$output" "doxia-parenthelp"

output=$("$TMPDIR/doxia" parenthelp-alias bogus --help)
assert_output_contains "trailing --help after an unresolved word renders help via alias route" "$output" "doxia-parenthelp"
if [[ $output == *"parenthelp-parent-ran"* ]]; then
  fail "trailing --help on an alias route does not execute the command"
fi
pass "trailing --help on an alias route does not execute the command"

output=$("$TMPDIR/doxia" parenthelp bogus --json --help)
grep -q '"ok": true' <<<"$output" || fail "--json with --help renders JSON help"
pass "--json with --help renders JSON help"

output=$("$TMPDIR/doxia" parenthelp "explain --json output" --help)
assert_output_contains "a --json embedded inside one argument does not switch help to JSON" "$output" "Partial resolution help test parent"

output=$("$TMPDIR/doxia" parenthelp bogus trailing)
assert_output_contains "leftover args without a help flag still forward" "$output" "parenthelp-parent-ran args=[bogus trailing]"

output=$("$TMPDIR/doxia" parenthelp run -- --help)
assert_output_contains "a --help behind -- belongs to the command and still forwards" "$output" "parenthelp-parent-ran args=[run -- --help]"

output=$("$TMPDIR/doxia" parenthelp --helpme x--help)
assert_output_contains "help lookalike tokens do not trigger help" "$output" "parenthelp-parent-ran args=[--helpme x--help]"
