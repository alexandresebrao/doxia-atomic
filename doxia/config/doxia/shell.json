{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "doxia.clock",
    "layout": {
      "left": [
        {
          "id": "doxia.menu"
        },
        {
          "id": "doxia.workspaces"
        }
      ],
      "center": [
        {
          "id": "doxia.indicators"
        },
        {
          "id": "doxia.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "doxia.keyboard-layout"
        },
        {
          "id": "doxia.weather"
        },
        {
          "id": "doxia.system-update"
        }
      ],
      "right": [
        {
          "id": "doxia.tray"
        },
        {
          "id": "doxia.agents"
        },
        {
          "id": "doxia.bluetooth"
        },
        {
          "id": "doxia.network"
        },
        {
          "id": "doxia.audio"
        },
        {
          "id": "doxia.monitor"
        },
        {
          "id": "doxia.power"
        }
      ]
    }
  },
  "plugins": []
}
