#!/bin/bash

# Voxtype dictation ready out of the box (the image carries the RPM): the DoxIA config (Portuguese, F9 push-to-talk), the
# Whisper model and the user service. What doxia-voxtype-install does after its
# confirmation, without the questions, so the ISO and Atualizar can run it.
# Every step is skipped when already done, so a hand-tuned config survives.
#
#   lib/install-voxtype   # as the user (doxia-setup-user): config, model, service

set -euo pipefail

if (( EUID == 0 )); then
  echo "Run as your user, not root." >&2
  exit 1
fi

doxia_path=${DOXIA_PATH:-/usr/share/doxia}

if [[ ! -f $HOME/.config/voxtype/config.toml ]]; then
  mkdir -p "$HOME/.config/voxtype"
  cp "$doxia_path/default/voxtype/config.toml" "$HOME/.config/voxtype/"
fi

# Downloads the model the config names (~500MB), only when it's missing.
voxtype setup --download --no-post-install --quiet

# The unit voxtype setup systemd writes, enabled through the .wants symlink because
# the installer has no user manager to ask (see install-user-units).
units=$HOME/.config/systemd/user
mkdir -p "$units/graphical-session.target.wants"
cat > "$units/voxtype.service" <<'UNIT'
[Unit]
Description=Voxtype push-to-talk voice-to-text daemon
Documentation=https://voxtype.io
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/voxtype daemon
Restart=on-failure
RestartSec=5

# Ensure we have access to the display
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=graphical-session.target
UNIT
ln -sfn ../voxtype.service "$units/graphical-session.target.wants/voxtype.service"

# On Atualizar the session is up: start it now. The F9 binds in
# default/mango/bindings/media.conf check for voxtype themselves.
if [[ -S ${XDG_RUNTIME_DIR:-/nonexistent}/bus ]]; then
  systemctl --user daemon-reload
  if systemctl --user is-active --quiet graphical-session.target; then
    systemctl --user start voxtype.service
  fi
fi
