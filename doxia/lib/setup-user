#!/bin/bash

# Per-user setup of DoxIA: seeds ~/.config, the theme, fonts, shell and apps
# for one account. Existing files are backed up, never clobbered. The
# installer runs it from its kickstart for the account it creates; any other
# account gets it on its first login, before the session starts, behind
# "Preparando sua conta" (doxia-setup-user.service, lib/setup-screen). Leaves
# ~/.local/state/doxia/setup-done behind; after that it only retries the
# downloads that failed (doxia-setup-retry.service, once the session is up).

set -euo pipefail

if (( EUID == 0 )); then
  echo "Run as your user, not root." >&2
  exit 1
fi

export DOXIA_PATH=/usr/share/doxia
backup_suffix=".bak-doxia-$(date +%Y%m%d%H%M%S)"

seed() {
  local src="$DOXIA_PATH/$1" dest="$2"
  if [[ -e $dest || -L $dest ]]; then
    mv "$dest" "$dest$backup_suffix"
    echo "  backed up $dest -> $dest$backup_suffix"
  fi
  mkdir -p "$(dirname "$dest")"
  cp -a "$src" "$dest"
}

# The steps that download (Chrome's extensions, Claude Code, the Whisper model):
# one that fails is retried on the next login.
optional_step() {
  local mark=$1 title=$2 script=$3
  doxia-done check "$mark" && return 0
  echo "==> $title"
  if bash "$DOXIA_PATH/lib/$script"; then
    doxia-done mark "$mark"
  else
    echo "  Failed; the next login retries."
  fi
}

optional_steps() {
  optional_step doxia-chrome "Google Chrome (flags, extensions, default browser)" install-chrome
  optional_step doxia-claude "Claude Code (the default coding agent)" install-claude
  optional_step doxia-voxtype "Voxtype dictation (config, Whisper model, user service; F9 to dictate)" install-voxtype
}

if [[ -f ~/.local/state/doxia/setup-done ]]; then
  optional_steps
  exit 0
fi

echo "==> Seeding DoxIA configs into ~/.config"
for item in mango doxia alacritty ghostty kitty btop imv lazygit tmux starship.toml; do
  seed "config/$item" "$HOME/.config/$item"
done
# The terminal order (Kitty first) is system-wide, from the image, so
# doxia-default-terminal's ~/.config/xdg-terminals.list can override it.

echo "==> DoxIA branding (About and screensaver logos, terminal greeting)"
mkdir -p ~/.config/doxia/branding
for file in about.txt screensaver.txt logo.ansi; do
  [[ -f ~/.config/doxia/branding/$file ]] || cp "$DOXIA_PATH/lib/branding/$file" ~/.config/doxia/branding/$file
done
mkdir -p ~/.bashrc.d
ln -sfn "$DOXIA_PATH/lib/greeting.sh" ~/.bashrc.d/doxia.sh

echo "==> DoxIA bar (∞ menu button, workspace icons, Now Playing, screen share, usage, services)"
bash "$DOXIA_PATH/lib/apply-bar"

echo "==> Menu extensions and default agent"
seed lib/doxia-menu.jsonc ~/.config/doxia/extensions/doxia-menu.jsonc
seed lib/default-agent ~/.config/doxia/defaults/agent

echo "==> nvm and SDKMAN! (Node.js and Java versions)"
bash "$DOXIA_PATH/lib/install-dev-tools"

echo "==> zsh with Oh My Zsh and the DoxIA theme (folder, git, Node.js and Java versions)"
bash "$DOXIA_PATH/lib/install-zsh"

echo "==> nano as the default editor (doxia-launch-editor, \$EDITOR) instead of nvim"
mkdir -p ~/.local/state/doxia/defaults
echo nano > ~/.local/state/doxia/defaults/editor

echo "==> uwsm session environment"
mkdir -p ~/.config/uwsm/env.d
ln -sfn "$DOXIA_PATH/default/uwsm/env.d/10-doxia" ~/.config/uwsm/env.d/10-doxia

echo "==> Fonts (JetBrainsMono Nerd Font + DoxIA glyph font)"
font_dir="$HOME/.local/share/fonts"
mkdir -p "$font_dir/JetBrainsMonoNerd" "$font_dir/doxia"
if [[ -z $(fc-list "JetBrainsMono Nerd Font") ]]; then
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/jbm.tar.xz" \
    https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.tar.xz
  tar -xJf "$tmp/jbm.tar.xz" -C "$font_dir/JetBrainsMonoNerd" --wildcards '*.ttf'
  rm -rf "$tmp"
fi
cp -f "$DOXIA_PATH/default/fonts/doxia/doxia.ttf" "$font_dir/doxia/"
fc-cache -f "$font_dir" >/dev/null
# The shell draws its text and Nerd Font icons with "monospace", which Fedora maps
# to Noto Sans Mono; without this, Qt fills icons like the weather glyphs from other
# fonts. Same file doxia-font-set writes, minus its shell restart.
if [[ ! -f ~/.config/fontconfig/fonts.conf ]]; then
  mkdir -p ~/.config/fontconfig
  cat > ~/.config/fontconfig/fonts.conf <<'XML'
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend_first" binding="strong">
      <string>JetBrainsMono Nerd Font</string>
    </edit>
  </match>
</fontconfig>
XML
fi

echo "==> GTK apps in the theme's colors and red folder icons (DoxIA default)"
for tpl in "$DOXIA_PATH"/lib/themed/*.tpl; do
  seed "lib/themed/$(basename "$tpl")" ~/.config/doxia/themed/"$(basename "$tpl")"
done
gtk_css=~/.config/gtk-4.0/gtk.css
mkdir -p "$(dirname "$gtk_css")"
if ! grep -q 'current/theme/gtk.css' "$gtk_css" 2>/dev/null; then
  echo "@import url('file://$HOME/.local/state/doxia/current/theme/gtk.css');" >> "$gtk_css"
fi
if ! grep -q 'nautilus-grid-view' "$gtk_css"; then
  cat >> "$gtk_css" <<'CSS'

/* Nautilus: grid icons 4% smaller (zoom only has ~25% steps). */
.nautilus-grid-view .nautilus-view-cell > :first-child {
  transform: scale(0.96);
}
CSS
fi
# GTK 3 apps (Evolution etc.) in the theme's colors: the theme-set hook gtk3-colors
# turns the theme's gtk3.css into a GTK theme in ~/.local/share/themes, which flatpaks may read.
flatpak override --user --filesystem=xdg-config/gtk-3.0:ro --filesystem=xdg-config/gtk-4.0:ro --filesystem=xdg-data/themes:ro
# The mail preview in the theme's colors, not the e-mail's own (once, so
# turning it off in DoxMail sticks; it shares Evolution's settings).
if ! doxia-done check doxia-evolution-colors && command -v doxmail &>/dev/null; then
  gsettings set org.gnome.evolution.mail preview-unset-html-colors true &&
    doxia-done mark doxia-evolution-colors
fi
# No minimize/maximize/close or app icon in GTK title bars: mango manages windows.
for ini in ~/.config/gtk-3.0/settings.ini ~/.config/gtk-4.0/settings.ini; do
  if [[ -f $ini ]] && grep -q '^gtk-decoration-layout=' "$ini"; then
    sed -i 's/^gtk-decoration-layout=.*/gtk-decoration-layout=:/' "$ini"
  fi
done
# ONLYOFFICE with the system title bar (also on every login, from mango's autostart).
bash "$DOXIA_PATH/lib/onlyoffice-titlebar"
bash "$DOXIA_PATH/themes/doxia/make-icons.sh"
# Lucide icons for the system (DoxIA's icons.theme), redone in the theme's text
# color on every theme change by the theme-set hook.
bash "$DOXIA_PATH/lib/lucide/make-theme"
# The shell's Nerd Font icons redrawn with Lucide (DoxIA Shell font, used only
# by doxia-shell), redone by the font-set hook when the font changes.
python3 "$DOXIA_PATH/lib/lucide/make-shell-font"
mkdir -p ~/.config/doxia/hooks
cp -r "$DOXIA_PATH/lib/hooks/." ~/.config/doxia/hooks/

echo "==> Theme (LiquidIA, the default)"
mkdir -p ~/.config/doxia/themes
if [[ ! -s ~/.local/state/doxia/current/theme.name ]]; then
  DOXIA_THEME_HEADLESS=1 doxia-theme-set "liquidia"
fi
mkdir -p ~/.config/btop/themes
ln -snf "$HOME/.local/state/doxia/current/theme/btop.theme" ~/.config/btop/themes/current.theme
# Headless theme-set skips gsettings (no session bus in the installer): set the
# dark scheme, the theme's icons and the bare title bars through a throwaway bus.
dbus-run-session -- bash -c 'doxia-theme-set-gnome
  gsettings set org.gnome.desktop.wm.preferences button-layout ":"'

echo "==> XCompose"
if [[ ! -f ~/.XCompose ]]; then
  # CapsLock is the compose key (doxia-restart-xcompose applies changes).
  cat >~/.XCompose <<EOF
# Run doxia-restart-xcompose to apply changes

# Include fast emoji access
include "$DOXIA_PATH/default/xcompose"

# Identification
<Multi_key> <space> <n> : "$(git config --global user.name || true)"
<Multi_key> <space> <e> : "$(git config --global user.email || true)"
EOF
fi

optional_steps

mkdir -p ~/.local/state/doxia
touch ~/.local/state/doxia/setup-done
echo "Done."
