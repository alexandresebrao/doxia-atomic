#!/bin/bash

# Depois de trocar a fonte (doxia-font-set <família>): refaz a DoxIA Shell, a
# cópia dessa fonte com os ícones Lucide que só o Quickshell usa, e reinicia o
# shell, que o doxia-font-set já reiniciou com a fonte antiga.

python3 "$DOXIA_PATH/lib/lucide/make-shell-font" "$1" && doxia-restart-shell
