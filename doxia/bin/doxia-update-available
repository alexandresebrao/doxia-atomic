#!/bin/bash

# doxia:summary=Check whether DoxIA updates are available.
# doxia-update-check compares the image and asks Flathub; this keeps the old
# one-line-per-update output and exit status.

set -euo pipefail

if ! status=$(doxia-update-check "$@"); then
  echo "DoxIA is up to date"
  exit 1
fi

jq -r '
  (if .staged.pending then "Update downloaded, waiting for the reboot" else empty end),
  (if (.system | length) > 0 then "New DoxIA image (\(.system[0].to))" else empty end),
  (if (.flatpak.apps | length) > 0 then "\(.flatpak.apps | length) Flatpak app(s)" else empty end),
  (if .flatpak.runtimes > 0 then "\(.flatpak.runtimes) Flatpak runtime(s)" else empty end)
' <<<"$status"
