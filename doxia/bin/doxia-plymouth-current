#!/bin/bash

# doxia:summary=Show which theme is styling the Plymouth boot screen
# doxia:examples=doxia plymouth current

# doxia-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/doxia/logo.png

if cmp -s "$DOXIA_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

doxia-plymouth-list | while read -r name; do
  if cmp -s "$(doxia-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
