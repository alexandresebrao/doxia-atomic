#!/bin/bash

# doxia:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the DoxIA default and rebuild it.
# doxia:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$DOXIA_PATH/bin/doxia-plymouth-set" --refresh-default
