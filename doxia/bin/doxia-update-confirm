#!/bin/bash

# doxia:summary=Prompt for confirmation before starting an update
# doxia:args=[now|boot]

when="• System packages install right away"
[[ ${1:-} == "boot" ]] && when="• System packages download now and install on the next reboot"

gum style --border normal --padding "1 2" \
  "Ready to update?" \
  "" \
  "$when" \
  "• You cannot stop the update once you start!" \
  "• Make sure you're connected to power or have a full battery" \
  "" \
  "What's new: https://github.com/alexandresebrao/doxia/releases/latest"

echo

if ! gum confirm "Continue with update?"; then
  echo "Update cancelled"
  exit 1
fi
