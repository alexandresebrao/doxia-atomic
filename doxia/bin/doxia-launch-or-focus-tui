#!/bin/bash

# doxia:summary=Launch a TUI or focus an existing terminal window for it
# doxia:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.doxia.$(basename "$1")"
fi

LAUNCH_COMMAND="doxia-launch-tui $@"

exec doxia-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
