#!/bin/bash

# doxia:summary=List available themes
# doxia:examples=doxia theme list | doxia theme set doxia

{
  find ~/.config/doxia/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$DOXIA_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
