#!/bin/bash

# doxia:summary=Open the Atualizar DoxIA window
# doxia:args=[--prefs]

# The window is its own app (rs/atualizar, installed by
# lib/install-rs), so the update can reload and restart the
# shell under it. A second launch raises the open window. Without the app,
# the doxia.update shell panel; without a running shell, the update in a
# terminal.
if doxia-cmd-present doxia-atualizar; then
  exec setsid uwsm-app -- doxia-atualizar "$@"
fi

payload='{}'
[[ ${1:-} == "--prefs" ]] && payload='{"tab": "prefs"}'
if [[ $(doxia-shell-call shell summon doxia.update "$payload" 2>/dev/null) != *ok* ]]; then
  exec doxia-launch-floating-terminal-with-presentation doxia-update
fi
