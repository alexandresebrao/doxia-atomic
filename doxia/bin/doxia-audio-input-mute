#!/bin/bash

# doxia:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  doxia-brightness-keyboard-mute on
  doxia-osd -i microphone-muted -m "Microfone mudo"
else
  doxia-brightness-keyboard-mute off
  doxia-osd -i microphone -m "Microfone ligado"
fi
