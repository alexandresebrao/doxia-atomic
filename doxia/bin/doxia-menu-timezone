#!/bin/bash

# doxia:summary=Select and set the system timezone
# doxia:group=menu
# doxia:name=timezone

set -e

timezone=$(timedatectl list-timezones | doxia-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
doxia-shell-call -q doxia.clock refresh
doxia-notification-send "Fuso horário definido como $timezone"
