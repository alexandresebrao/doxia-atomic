#!/bin/bash

# doxia:summary=Regenerate the AI agent usage data files
# doxia:args=[--force] [--limits-only] [--except <agent>] [agent...]
# doxia:examples=doxia agent usage-update | doxia agent usage-update claude | doxia agent usage-update --except codex

# Each doxia-agent-usage-<agent> collector prints one display-ready JSON
# record; this writes them to ~/.local/state/doxia/agents/usage/ where the
# agents panel watches them. Adding an agent is adding a collector — the
# panel picks up any record that appears here.

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/doxia/agents/usage"
mkdir -p "$USAGE_DIR"

flags=()
only=()
declare -A excluded

while [[ $# -gt 0 ]]; do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    excluded[$2]=1
    shift
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1"
  [[ -n ${excluded[$agent]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

collect() {
  local collector="$1" agent="$2"
  local record tmp
  if ! record=$("$collector" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "doxia-agent-usage-update: $agent collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$agent.json"
}

pids=()
found=0
for collector in "$DOXIA_PATH"/bin/doxia-agent-usage-*; do
  [[ -x $collector ]] || continue
  agent="${collector##*/doxia-agent-usage-}"
  [[ $agent == "update" ]] && continue
  found=1
  wanted "$agent" || continue
  collect "$collector" "$agent" &
  pids+=($!)
done

# Found by the glob above only: without this, losing every collector
# leaves the panel's records silently stale.
if ((!found)); then
  echo "doxia-agent-usage-update: no doxia-agent-usage-<agent> collector in $DOXIA_PATH/bin" >&2
  exit 1
fi

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
exit $status
