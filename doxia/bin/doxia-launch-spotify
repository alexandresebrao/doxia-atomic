#!/bin/bash

# doxia:summary=Launch Spotify or start its installer when missing.

set -e

WINDOW_ID=$(mmsg get all-clients 2>/dev/null | jq -r 'first(.clients[] | select((.appid | test("\\bspotify\\b"; "i")) or (.title | test("\\bspotify\\b"; "i")))).id // empty')

if [[ -n $WINDOW_ID ]]; then
  mmsg dispatch focusid "client,$WINDOW_ID" >/dev/null
elif [[ -x /usr/bin/spotify ]]; then
  exec setsid uwsm-app -- /usr/bin/spotify
elif flatpak info com.spotify.Client >/dev/null 2>&1; then
  exec setsid uwsm-app -- flatpak run com.spotify.Client
else
  exec doxia-launch-floating-terminal-with-presentation doxia-install-service-spotify
fi
