#!/bin/bash

# doxia:summary=Update DoxIA: the system image, Flatpak apps and mise tools
# doxia:args=[-y] [--now|--boot|--flatpak] [--gui]
# doxia:examples=doxia update | doxia update -y | doxia update --now
# doxia:requires-sudo=true

# The system is an image (bootc): an update downloads the new one and stages
# it, and it boots on the next restart. The running system never changes
# under the open apps, and the previous image stays in the boot menu.
#
# --boot     stage the new image; it starts on the next restart (default)
# --now      stage it and restart right away
# --flatpak  only the Flatpak apps: no password, no restart
# Without one, the "mode" preference decides (doxia-update-pref, set in the
# Atualizar DoxIA window). --gui is how that window runs it (doxia-update-run):
# no prompts, the password comes through doxia-update-askpass, and each step
# is recorded with doxia-update-state for the window and the bar icon.

set -eE

# Lowest CPU and disk priority, inherited by everything the update starts:
# unpacking the image layers would otherwise starve the compositor.
renice -n 19 -p $$ >/dev/null 2>&1 || true
ionice -c 2 -n 7 -p $$ >/dev/null 2>&1 || true

if [[ -z ${DOXIA_UPDATE_LOGGED:-} ]] && doxia-cmd-present script; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env DOXIA_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/doxia-update.log"
fi

if ! doxia-update-lock held; then
  exec doxia-update-lock run "$0" "$@"
fi

assume_yes=0
gui=0
mode=""
for arg in "$@"; do
  case $arg in
    -y) assume_yes=1 ;;
    --now) mode=now ;;
    --boot) mode=boot ;;
    --flatpak) mode=flatpak ;;
    --gui) gui=1 assume_yes=1 ;;
  esac
done
[[ -n $mode ]] || mode=$(doxia-update-pref get mode)

state() { (( gui )) && doxia-update-state "$@"; true; }

current_step=""
run_step() {
  current_step=$1
  shift
  state step "$current_step" run
  "$@"
  state step "$current_step" done
}

finish_failed() {
  echo ""
  echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\033[0m"
  state step "$current_step" fail
  state finish failed "$current_step"
}

trap finish_failed ERR
trap 'doxia-update-stay-awake stop' EXIT
trap 'state finish canceled; exit 130' TERM INT

# -y is a promise not to ask anything. Steps that would need an answer report
# and move on instead of waiting on a prompt nobody is here to give.
(( assume_yes )) && export DOXIA_UPDATE_UNATTENDED=1
(( gui )) && export DOXIA_UPDATE_GUI=1

if [[ $mode == "flatpak" ]]; then
  state begin flatpak flatpak:"Apps Flatpak":1
  run_step flatpak doxia-update-aur-pkgs
  doxia-update-status
  state finish ok
  exit 0
fi

state begin "$mode" space:"Espaço livre":1 flatpak:"Apps Flatpak":8 mise:"Ferramentas (mise)":3 \
  system:"Baixar o novo DoxIA":40

run_step space doxia-update-requires-free-space

(( assume_yes )) || doxia-update-confirm "$mode" || exit 0

# The exact commands the password authorizes, shown in the update window.
root_commands=("flatpak update -y --noninteractive" "bootc upgrade  (baixa e prepara a nova imagem)")
[[ $mode == "now" ]] && root_commands+=("reinício logo em seguida")
state set rootCommands "$(printf '%s\n' "${root_commands[@]}" | jq -R . | jq -sc .)"

# One password for the whole update, kept fresh in the background: pulling
# the image can take longer than sudo remembers it.
if (( gui )); then
  run_dir="${XDG_RUNTIME_DIR:-/tmp}/doxia-update"
  rm -f "$run_dir/askpass.fifo" "$run_dir/askpass.count"
  mkfifo -m 0600 "$run_dir/askpass.fifo"
  sudo -k
  if ! SUDO_ASKPASS="$DOXIA_PATH/bin/doxia-update-askpass" sudo -A -v 2>/dev/null; then
    rm -f "$run_dir/askpass.fifo"
    trap - ERR
    state finish canceled "Senha não confirmada"
    exit 1
  fi
  rm -f "$run_dir/askpass.fifo"
else
  sudo -v || exit 1
fi
# Its sleep outlives the update by up to 50 seconds. Holding the update lock or
# the update's output that long would turn a retry away as already running.
(
  [[ -n ${DOXIA_UPDATE_LOCK_FD:-} ]] && exec {DOXIA_UPDATE_LOCK_FD}>&-
  while kill -0 $$ 2>/dev/null; do sudo -n -v 2>/dev/null; sleep 50; done
) >/dev/null 2>&1 &
sudo_keepalive=$!
trap 'kill "$sudo_keepalive" 2>/dev/null; doxia-update-stay-awake stop' EXIT

doxia-update-stay-awake start

# Flatpak and mise live outside the image, so they update now.
run_step flatpak doxia-update-aur-pkgs
run_step mise doxia-update-mise
run_step system doxia-update-image

doxia-update-analyze-logs
doxia-update-check >/dev/null || true
doxia-update-status

doxia-update-stay-awake stop
kill "$sudo_keepalive" 2>/dev/null
trap - EXIT ERR

if ! doxia-update-image staged; then
  # Already on the newest image: only the apps changed.
  state finish ok
  exit 0
fi

state set summary "$(doxia-update-check --cached | jq -c '{packages: (.staged.packages | length)}')"
state finish staged

if [[ $mode == "now" ]]; then
  doxia-system-reboot
elif (( ! assume_yes )); then
  echo
  gum confirm "O novo DoxIA começa no próximo reinício. Reiniciar agora?" && doxia-system-reboot
else
  echo "The new DoxIA starts on the next reboot."
fi
