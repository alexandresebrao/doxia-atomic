#!/bin/bash

# doxia:summary=Launch the default coding agent with a prompt
# doxia:args=[--inline] <prompt...>
# doxia:examples=doxia agent prompt "Review this project"

# Prompts live here rather than on `doxia agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: doxia agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec doxia-agent "${inline[@]}" --prompt "$*"
