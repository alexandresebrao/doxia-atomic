#!/bin/bash

# doxia:summary=Pick a webcam and start a screen recording with it
# doxia:examples=doxia capture screenrecording-with-webcam

mapfile -t devices < <(doxia-capture-webcam-list)
if (( ${#devices[@]} == 0 )); then
  doxia-notification-send "Nenhuma webcam encontrada" -u critical -t 3000
  exit 1
fi

if (( ${#devices[@]} == 1 )); then
  device="${devices[0]%%[[:space:]]*}"
else
  selection=$(doxia-menu-select "Select Webcam" "${devices[@]}" -- --width 520 --maxheight 520) || exit 1
  device="${selection%%[[:space:]]*}"
fi

exec doxia-capture-screenrecording \
  --with-desktop-audio --with-microphone-audio \
  --with-webcam --webcam-device="$device"
