#!/bin/bash

# doxia:summary=Extract text from a screenshot region with OCR
# doxia:group=capture
# doxia:examples=doxia capture text

# Keep doxia-freeze alive until after grim captures so the screenshot sees the
# frozen overlay rather than live content shifting during teardown.
cleanup_freeze() {
  [[ -n $PID ]] && kill $PID 2>/dev/null
}
trap cleanup_freeze EXIT

PID=$(doxia-freeze --background 2>/dev/null)
SELECTION=$(slurp 2>/dev/null)

[[ -z $SELECTION ]] && exit 0

TEXT=$(grim -g "$SELECTION" - | tesseract stdin stdout --oem 1 --psm 6 -l "${DOXIA_OCR_LANGS:-eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1

[[ -z $TEXT ]] && exit 1

printf "%s" "$TEXT" | wl-copy
doxia-notification-send -g 󰴑 "Texto da seleção copiado para a área de transferência"
