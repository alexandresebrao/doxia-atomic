#!/usr/bin/python3

# doxia:summary=List what an update would change: the DoxIA image and Flatpak apps
# doxia:args=[--refresh] [--cached]
# doxia:examples=doxia update check | doxia update check --refresh

"""Prints a JSON summary and keeps a copy in ~/.cache/doxia/update-status.json
for the update window and the bar icon. Exits 0 when there is something to do
(including an update downloaded and waiting for the reboot), 1 otherwise.

  --refresh  accepted for compatibility: the registry is always asked
  --cached   print the last summary without checking again

The system part compares the image the machine booted (rpm-ostree status)
with the newest one in the registry (skopeo inspect): one entry when the
registry has a newer image, none when it is the same.
"""

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

CACHE = Path.home() / ".cache/doxia/update-status.json"


def run(cmd, timeout=180):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired):
        return -1, ""


def deployments():
    code, out = run(["rpm-ostree", "status", "--json"], 30)
    if code != 0:
        return []
    try:
        return json.loads(out).get("deployments", [])
    except ValueError:
        return []


def image_label(info, *keys):
    labels = info.get("Labels") or {}
    for key in keys:
        if labels.get(key):
            return labels[key]
    return ""


def image_ref(reference):
    """bootc's image reference as skopeo takes it:
    ostree-unverified-registry:ghcr.io/x:latest      -> docker://ghcr.io/x:latest
    ostree-remote-registry:fedora:ghcr.io/x:latest   -> docker://ghcr.io/x:latest
    ostree-image-signed:docker://ghcr.io/x:latest    -> docker://ghcr.io/x:latest"""
    if "docker://" in reference:
        return "docker://" + reference.split("docker://", 1)[1]
    if reference.startswith("ostree-remote-registry:"):
        return "docker://" + reference.split(":", 2)[2]
    return "docker://" + reference.split(":", 1)[1]


def system_updates(errors):
    booted = next((d for d in deployments() if d.get("booted")), None)
    if not booted or not booted.get("container-image-reference"):
        errors.append("O sistema não segue uma imagem do DoxIA (bootc).")
        return []
    ref = image_ref(booted["container-image-reference"])
    code, out = run(["skopeo", "inspect", "--no-tags", ref], 60)
    if code != 0:
        errors.append("Não foi possível consultar o registro de imagens do DoxIA.")
        return []
    try:
        remote = json.loads(out)
    except ValueError:
        return []
    if remote.get("Digest") == booted.get("container-image-reference-digest"):
        return []
    to = image_label(remote, "org.opencontainers.image.version") or remote.get("Created", "")[:10]
    return [{"name": "DoxIA", "arch": remote.get("Architecture", ""), "repo": ref.removeprefix("docker://"),
             "from": booted.get("version") or "", "to": to}]


def flatpak_updates(errors):
    apps, runtimes = [], 0
    code, out = run(["flatpak", "remote-ls", "--updates", "--columns=ref,name"])
    if code != 0:
        if code != -1 or Path("/usr/bin/flatpak").exists():
            errors.append("Não foi possível consultar o Flathub.")
        return {"apps": apps, "runtimes": runtimes}
    for line in out.splitlines():
        ref, _, name = line.partition("\t")
        if ref.startswith("app/"):
            apps.append({"id": ref.split("/")[1], "name": name.strip() or ref.split("/")[1]})
        elif ref.startswith("runtime/"):
            runtimes += 1
    return {"apps": apps, "runtimes": runtimes}


def staged():
    stage = next((d for d in deployments() if d.get("staged")), None)
    data = {"pending": stage is not None, "packages": [], "stagedAt": 0, "finishing": False}
    if stage:
        data["stagedAt"] = stage.get("timestamp", 0)
        _, out = run(["doxia-update-image", "diff"], 60)
        data["packages"] = [line for line in out.splitlines() if line]
    return data


def main(args):
    if "--cached" in args:
        try:
            status = json.loads(CACHE.read_text())
        except (OSError, ValueError):
            sys.exit(1)
    else:
        errors = []
        stage = staged()
        status = {
            "checkedAt": int(time.time()),
            # A staged image already holds the system update.
            "system": [] if stage["pending"] else system_updates(errors),
            "flatpak": flatpak_updates(errors),
            # DoxIA itself is part of the image: no checkout to follow.
            "doxia": {"behind": 0, "upstream": "", "head": "", "commits": []},
            "staged": stage,
            # The previous image is the rollback: no snapshots needed.
            "snapper": False,
            "errors": errors,
        }
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        tmp = CACHE.with_name(CACHE.name + ".tmp")
        tmp.write_text(json.dumps(status))
        tmp.replace(CACHE)

    print(json.dumps(status))
    pending = (status["system"] or status["flatpak"]["apps"] or status["flatpak"]["runtimes"]
               or status["staged"]["pending"])
    sys.exit(0 if pending else 1)


main(sys.argv[1:])
