#!/bin/bash

# doxia:summary=Remove Voxtype dictation and its configuration
# doxia:requires-sudo=true

set -e

# Remove voxtype and its configurations.

if doxia-cmd-present voxtype; then
  echo "Desinstalando o Voxtype para remover o ditado."

  # Remove services
  systemctl --user disable --now voxtype.service 2>/dev/null || true
  systemctl --user daemon-reload

  # Remove packages and configs
  doxia-pkg-drop voxtype
  rm -rf ~/.config/voxtype
  rm -rf ~/.local/share/voxtype
  doxia-restart-mango
else
  echo "O Voxtype não estava instalado."
fi
