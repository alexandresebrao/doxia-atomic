#!/bin/bash

# doxia:summary=Toggle crash capture notifications

# nf-md-robot_dead, escaped so this file reads without a Nerd Font.
readonly CRASH_GLYPH=$'\U000f16a1'

doxia-toggle crash-capture-off

# The unit checks the same flag with ConditionPathExists, so stopping and
# starting only settles this session; the next login reads the flag itself.
if doxia-toggle-enabled crash-capture-off; then
  systemctl --user stop doxia-crash-watch.service
  doxia-notification-send -g "$CRASH_GLYPH" "Captura de travamentos desativada"
else
  systemctl --user start doxia-crash-watch.service
  doxia-notification-send -g "$CRASH_GLYPH" "Captura de travamentos ativada"
fi
