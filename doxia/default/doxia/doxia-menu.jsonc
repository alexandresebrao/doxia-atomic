{
  // DoxIA menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. Use provider:"name" only when the submenu
  // calls provider_name() or a command named "name" to return JSON rows.
  // Optional fields:
  //   aliases        alternate `doxia menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Aprender"},
  "trigger": {"icon":"󱓞","label":"Ações"},
  "style": {"icon":"","label":"Estilo"},
  "setup": {"icon":"","label":"Configurar","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Instalar"},
  "remove": {"icon":"󰭌","label":"Remover","aliases":["uninstall"]},
  "update": {"icon":"","label":"Atualizar","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"Sobre","action":"doxia-launch-about"},
  "system": {"icon":"","label":"Sistema","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Proteção de tela","action":"doxia-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Bloquear","action":"doxia-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspender","when":"! doxia-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernar","when":"doxia-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Sair da sessão","action":"doxia-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reiniciar","action":"doxia-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Desligar","action":"doxia-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Atalhos de teclado","action":"doxia-menu-keybindings"},
  "learn.doxia": {"icon":"","label":"DoxIA","action":"doxia-launch-webapp 'https://github.com/alexandresebrao/doxia'"},
  "learn.mango": {"icon":"","label":"mango","action":"doxia-launch-webapp 'https://github.com/mangowm/mango/wiki'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"doxia-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"doxia-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"doxia-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"doxia-menu-tmux-keybindings"},
  "learn.herdr-keybindings": {"icon":"","label":"Herdr","action":"doxia-menu-herdr-keybindings"},
  "learn.community": {"icon":"󰙯","label":"Comunidade","action":"doxia-launch-discord-community"},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"doxia-menu-emoji"},
  "trigger.reminder": {"icon":"󰢌","label":"Lembrete","aliases":["reminder"]},
  "trigger.capture": {"icon":"","label":"Capturar","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Captura de tela","action":"doxia-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Parar gravação de tela","when":"pgrep -f '^gpu-screen-recorder'","action":"doxia-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Gravar tela"},
  "trigger.capture.text": {"icon":"󰴑","label":"Texto","action":"doxia-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"doxia-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Cor","action":"doxia-capture-color"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"Sem áudio","action":"doxia-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"Com áudio do sistema","action":"doxia-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"Com áudio do sistema + microfone","action":"doxia-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"Com áudio do sistema + microfone + webcam","when":"doxia-hw-webcam","action":"doxia-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Converter mídia","action":"doxia-transcode"},
  "trigger.share": {"icon":"","label":"Compartilhar","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Alternar","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Teste de velocidade"},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Tela do notebook","when":"doxia-hw-laptop","action":"doxia-mango-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Espelhar tela","when":"doxia-hw-laptop","action":"doxia-mango-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"GPU híbrida","when":"doxia-hw-hybrid-gpu","action":"doxia-launch-floating-terminal-with-presentation doxia-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"doxia-hw-touchpad","action":"doxia-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Vibração do touchpad"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"baixa","when":"doxia-hw-dell-xps-haptic-touchpad && doxia-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"média","when":"doxia-hw-dell-xps-haptic-touchpad && doxia-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","label":"alta","when":"doxia-hw-dell-xps-haptic-touchpad && doxia-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]","action":"dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Tela sensível ao toque","when":"doxia-hw-touchscreen","action":"doxia-toggle-touchscreen"},
  "trigger.reminder.set": {"icon":"󰢌","label":"Criar lembrete","aliases":["reminder-set","remind"],"action":"doxia-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Mostrar todos","action":"doxia-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Limpar todos","action":"doxia-reminder clear"},
  "trigger.share.clipboard": {"icon":"","label":"Área de transferência","action":"doxia-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"Arquivo","action":"doxia-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Pasta","action":"doxia-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receber","action":"uwsm-app -- localsend"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Manter acordado","action":"doxia-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notificações","action":"doxia-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon":"󱚡","label":"Captura de falhas","action":"doxia-toggle-crash-capture"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Proteção de tela","action":"doxia-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Luz noturna","action":"doxia-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Barra de menu","action":"doxia-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","label":"Porcentagem da bateria","when":"doxia-hw-laptop","action":"doxia-shell-call doxia.power togglePercentage"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Layout das áreas de trabalho","action":"mmsg dispatch switch_layout"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Espaçamento das janelas","action":"mmsg dispatch togglegaps"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Teste de velocidade da rede","action":"doxia-shell-call shell summon doxia.speedtest"},
  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Teste de velocidade do disco","action":"doxia-shell-call shell summon doxia.disk-speedtest"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Tema","aliases":["theme","themes"],"action":"theme=$(doxia-theme-switcher); [[ -n $theme ]] && doxia-theme-set \"$theme\""},
  "style.background": {"icon":"","label":"Papel de parede","aliases":["background","wallpaper"],"action":"background=$(doxia-theme-bg-switcher); [[ -n $background ]] && doxia-theme-bg-set \"$background\""},
  "style.unlock": {"icon":"󰟵","label":"Tela de desbloqueio","aliases":["unlock"],"action":"unlock=$(doxia-plymouth-switcher); if [[ $unlock == default ]]; then doxia-launch-floating-terminal-with-presentation doxia-plymouth-reset; elif [[ -n $unlock ]]; then doxia-launch-floating-terminal-with-presentation \"doxia-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi"},
  "style.font": {"icon":"","label":"Fonte","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Barra de menu"},
  "style.bar.position": {"icon":"","label":"Posição"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparência","action":"doxia-bar transparent toggle"},
  "style.mango": {"icon":"","label":"Janelas","action":"doxia-launch-config-editor \"$HOME/.config/mango/looknfeel.conf\""},
  "style.screensaver": {"icon":"󱄄","label":"Proteção de tela"},
  "style.about": {"icon":"","label":"Sobre"},
  "style.bar.position.top": {"icon":"󰁝","label":"Em cima","action":"doxia-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Embaixo","action":"doxia-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Esquerda","action":"doxia-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Direita","action":"doxia-bar position right"},
  "style.about.text": {"icon":"","label":"Editar texto","action":"doxia-branding-about text"},
  "style.about.image": {"icon":"","label":"Definir a partir de imagem","action":"doxia-branding-about image"},
  "style.about.default": {"icon":"","label":"Restaurar padrão","action":"doxia-branding-about reset"},
  "style.screensaver.text": {"icon":"","label":"Editar texto","action":"doxia-branding-screensaver text"},
  "style.screensaver.image": {"icon":"","label":"Definir a partir de imagem","action":"doxia-branding-screensaver image"},
  "style.screensaver.default": {"icon":"","label":"Restaurar padrão","action":"doxia-branding-screensaver reset"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitores","action":"doxia-launch-config-editor \"$HOME/.config/mango/monitors.conf\""},
  "setup.keybindings": {"icon":"","label":"Atalhos de teclado","when":"[[ -f ~/.config/mango/bindings.conf ]]","action":"doxia-launch-config-editor \"$HOME/.config/mango/bindings.conf\""},
  "setup.input": {"icon":"","label":"Entrada","when":"[[ -f ~/.config/mango/input.conf ]]","action":"doxia-launch-config-editor \"$HOME/.config/mango/input.conf\""},
  "setup.network": {"icon":"󰛳","label":"Rede","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(doxia-dns)\" == \"DHCP\" ]]","action":"doxia-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(doxia-dns)\" == \"Cloudflare\" ]]","action":"doxia-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(doxia-dns)\" == \"Google\" ]]","action":"doxia-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Personalizado","checked":"[[ \"$(doxia-dns)\" == \"Custom\" ]]","action":"doxia-launch-floating-terminal-with-presentation 'doxia-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(doxia-network-status) == wifi* ]]","action":"doxia-shell-call shell summon doxia.wifiqr"},
  "setup.default": {"icon":"","label":"Padrões","aliases":["default","defaults"]},
  "setup.default.agent": {"icon":"󰚩","label":"Agente","title":"Agente padrão"},
  "setup.default.agent.claude": {"icon":"󰛄","label":"Claude","checked":"[[ \"$(doxia-default-agent)\" == \"claude\" ]]","action":"doxia-default-agent claude"},
  "setup.default.agent.codex": {"icon":"","iconFont":"doxia","label":"Codex","checked":"[[ \"$(doxia-default-agent)\" == \"codex\" ]]","action":"doxia-default-agent codex"},
  "setup.default.agent.copilot": {"icon":"","label":"Copilot","checked":"[[ \"$(doxia-default-agent)\" == \"copilot\" ]]","action":"doxia-default-agent copilot"},
  "setup.default.agent.crush": {"icon":"󰋑","label":"Crush","checked":"[[ \"$(doxia-default-agent)\" == \"crush\" ]]","action":"doxia-default-agent crush"},
  "setup.default.agent.cursor-agent": {"icon":"","iconFont":"doxia","label":"Cursor CLI","checked":"[[ \"$(doxia-default-agent)\" == \"cursor-agent\" ]]","action":"doxia-default-agent cursor-agent"},
  "setup.default.agent.gemini": {"icon":"󰫢","label":"Gemini","checked":"[[ \"$(doxia-default-agent)\" == \"gemini\" ]]","action":"doxia-default-agent gemini"},
  "setup.default.agent.grok": {"icon":"","iconFont":"doxia","label":"Grok","checked":"[[ \"$(doxia-default-agent)\" == \"grok\" ]]","action":"doxia-default-agent grok"},
  "setup.default.agent.hermes": {"icon":"","iconFont":"doxia","label":"Hermes","checked":"[[ \"$(doxia-default-agent)\" == \"hermes\" ]]","action":"doxia-default-agent hermes"},
  "setup.default.agent.muse": {"icon":"󰛤","label":"Muse Code","checked":"[[ \"$(doxia-default-agent)\" == \"muse\" ]]","action":"doxia-default-agent muse"},
  "setup.default.agent.omp": {"icon":"","iconFont":"doxia","label":"omp","checked":"[[ \"$(doxia-default-agent)\" == \"omp\" ]]","action":"doxia-default-agent omp"},
  "setup.default.agent.openclaw": {"icon":"","iconFont":"doxia","label":"OpenClaw","checked":"[[ \"$(doxia-default-agent)\" == \"openclaw\" ]]","action":"doxia-default-agent openclaw"},
  "setup.default.agent.opencode": {"icon":"","iconFont":"doxia","label":"OpenCode","checked":"[[ \"$(doxia-default-agent)\" == \"opencode\" ]]","action":"doxia-default-agent opencode"},
  "setup.default.agent.pi": {"icon":"","iconFont":"doxia","label":"Pi","checked":"[[ \"$(doxia-default-agent)\" == \"pi\" ]]","action":"doxia-default-agent pi"},
  "setup.default.browser": {"icon":"","label":"Navegador","title":"Navegador padrão"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","when":"doxia-cmd-present chromium","checked":"[[ \"$(doxia-default-browser)\" == \"chromium\" ]]","action":"doxia-default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","when":"doxia-cmd-present google-chrome-stable","checked":"[[ \"$(doxia-default-browser)\" == \"chrome\" ]]","action":"doxia-default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","when":"doxia-cmd-present brave","checked":"[[ \"$(doxia-default-browser)\" == \"brave\" ]]","action":"doxia-default-browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","when":"doxia-cmd-present brave-origin","checked":"[[ \"$(doxia-default-browser)\" == \"brave-origin\" ]]","action":"doxia-default-browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","when":"doxia-cmd-present microsoft-edge-stable","checked":"[[ \"$(doxia-default-browser)\" == \"edge\" ]]","action":"doxia-default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","when":"doxia-cmd-present firefox","checked":"[[ \"$(doxia-default-browser)\" == \"firefox\" ]]","action":"doxia-default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","when":"doxia-cmd-present zen-browser","checked":"[[ \"$(doxia-default-browser)\" == \"zen\" ]]","action":"doxia-default-browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminal","title":"Terminal padrão"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","when":"doxia-cmd-present alacritty","checked":"[[ \"$(doxia-default-terminal)\" == \"alacritty\" ]]","action":"doxia-default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","when":"doxia-cmd-present foot","checked":"[[ \"$(doxia-default-terminal)\" == \"foot\" ]]","action":"doxia-default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","when":"doxia-cmd-present ghostty","checked":"[[ \"$(doxia-default-terminal)\" == \"ghostty\" ]]","action":"doxia-default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","when":"doxia-cmd-present kitty","checked":"[[ \"$(doxia-default-terminal)\" == \"kitty\" ]]","action":"doxia-default-terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Editor","title":"Editor padrão"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","when":"doxia-cmd-present nvim","checked":"[[ \"$(doxia-default-editor)\" == \"nvim\" ]]","action":"doxia-default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","when":"doxia-cmd-present code","checked":"[[ \"$(doxia-default-editor)\" == \"code\" ]]","action":"doxia-default-editor code"},
  "setup.default.editor.cursor": {"icon":"","iconFont":"doxia","label":"Cursor","when":"doxia-cmd-present cursor","checked":"[[ \"$(doxia-default-editor)\" == \"cursor\" ]]","action":"doxia-default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","when":"doxia-cmd-present zeditor","checked":"[[ \"$(doxia-default-editor)\" == \"zeditor\" ]]","action":"doxia-default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","when":"doxia-cmd-present sublime_text","checked":"[[ \"$(doxia-default-editor)\" == \"sublime_text\" ]]","action":"doxia-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","when":"doxia-cmd-present helix","checked":"[[ \"$(doxia-default-editor)\" == \"helix\" ]]","action":"doxia-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","when":"doxia-cmd-present vim","checked":"[[ \"$(doxia-default-editor)\" == \"vim\" ]]","action":"doxia-default-editor vim"},
  "setup.default.editor.nano": {"icon":"","label":"Nano","when":"doxia-cmd-present nano","checked":"[[ \"$(doxia-default-editor)\" == \"nano\" ]]","action":"doxia-default-editor nano"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","when":"doxia-cmd-present emacs","checked":"[[ \"$(doxia-default-editor)\" == \"emacs\" ]]","action":"doxia-default-editor emacs"},
  "setup.security": {"icon":"","label":"Segurança"},
  "setup.config": {"icon":"","label":"Configuração"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Impressão digital","when":"doxia-hw-fingerprint","action":"doxia-launch-floating-terminal-with-presentation doxia-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"doxia-launch-floating-terminal-with-presentation doxia-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"doxia-launch-floating-terminal-with-presentation doxia-setup-security-sshd"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Sudo sem senha","action":"doxia-launch-floating-terminal-with-presentation doxia-sudo-passwordless"},
  "setup.security.sudoless-docker": {"icon":"󰡨","label":"Docker sem sudo","when":"doxia-sudo-docker --configured","action":"doxia-launch-floating-terminal-with-presentation doxia-setup-security-sudoless-docker"},
  "setup.config.mango": {"icon":"","label":"mango","action":"doxia-launch-config-editor \"$HOME/.config/mango/config.conf\""},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"doxia-launch-config-editor ~/.XCompose && doxia-restart-xcompose"},
  "setup.direct-boot": {"icon":"","label":"Inicialização direta","action":"doxia-launch-floating-terminal-with-presentation doxia-setup-direct-boot"},
  "setup.reset": {"icon":"󰑓","label":"Restaurar computador","when":"[[ $(findmnt -no FSTYPE /) == btrfs ]]","action":"doxia-launch-floating-terminal-with-presentation doxia-system-factory-reset"},

  // Install
  "install.package": {"icon":"","label":"Pacote","action":"xdg-terminal-exec --app-id=org.doxia.terminal doxia-pkg-install"},
  "install.flatpak": {"icon":"󰏗","label":"Flatpak","action":"xdg-terminal-exec --app-id=org.doxia.terminal doxia-pkg-flatpak-install"},
  "install.webapp": {"icon":"","label":"Web App","action":"doxia-launch-floating-terminal-with-presentation doxia-webapp-install"},
  "install.tui": {"icon":"","label":"TUI","action":"doxia-launch-floating-terminal-with-presentation doxia-tui-install"},
  "install.style": {"icon":"","label":"Estilo"},
  "install.style.theme": {"icon":"󰸌","label":"Tema","action":"doxia-launch-floating-terminal-with-presentation doxia-theme-install"},
  "install.style.background": {"icon":"","label":"Papel de parede","action":"doxia-theme-bg-install"},
  "install.style.font": {"icon":"","label":"Fonte"},
  "install.style.font.cascadia": {"icon":"","label":"Cascadia Mono","action":"doxia-install-font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'"},
  "install.style.font.meslo": {"icon":"","label":"Meslo LG Mono","action":"doxia-install-font 'Meslo LG Mono' ttf-meslo-nerd 'MesloLGL Nerd Font'"},
  "install.style.font.fira": {"icon":"","label":"Fira Code","action":"doxia-install-font 'Fira Code' ttf-firacode-nerd 'FiraCode Nerd Font'"},
  "install.style.font.victor": {"icon":"","label":"Victor Code","action":"doxia-install-font 'Victor Code' ttf-victor-mono-nerd 'VictorMono Nerd Font'"},
  "install.style.font.bitstream": {"icon":"","label":"Bitstream Vera Mono","action":"doxia-install-font 'Bitstream Vera Code' ttf-bitstream-vera-mono-nerd 'BitstromWera Nerd Font'"},
