# Single source of truth for DOXIA_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/doxia.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-doxia          (Hyprland session via uwsm)
#   /usr/share/doxia/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/doxia.conf is written by doxia-dev-link and reset by
# doxia-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/doxia.conf ]; then
  . /etc/doxia.conf
  : "${DOXIA_PATH:=/usr/share/doxia}"
else
  DOXIA_PATH=/usr/share/doxia
fi
export DOXIA_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/doxia-* via the doxia package — prepending
# /usr/share/doxia/bin would just be noise.
if [ "$DOXIA_PATH" != /usr/share/doxia ]; then
  case ":$PATH:" in
    *":${DOXIA_PATH%/}/bin:"*) ;;
    *) PATH="${DOXIA_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
