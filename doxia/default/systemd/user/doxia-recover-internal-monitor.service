[Unit]
Description=Recover the internal monitor toggle when no external display is connected
Before=graphical-session-pre.target
ConditionPathExists=%h/.local/state/doxia/toggles/mango/internal-monitor-disable

[Service]
Type=oneshot
ExecStart=/usr/bin/doxia-hw-recover-internal-monitor

[Install]
WantedBy=graphical-session-pre.target
