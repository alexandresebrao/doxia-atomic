# The DoxIA shell daemon (rs/shell): the OSD and the notification
# server, so it comes back if it dies. Enabled for every user by the image (build/steps/50-services.sh),
# started by mango's autostart once the session environment is imported.
[Unit]
Description=DoxIA shell (OSD and notifications)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=mango:wlroots
ConditionPathExists=/usr/bin/doxia-shell

[Service]
Type=dbus
BusName=org.doxia.Shell
ExecStart=/usr/bin/doxia-shell
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
