# The per-user DoxIA setup on an account's first login, before the session
# starts: lib/setup-screen runs lib/setup-user behind "Preparando sua conta".
# The installer already ran it for the account it created (setup-done).
# After graphical-session-pre.target, when uwsm has imported the login's
# environment (mango needs XDG_SESSION_ID for the seat), and before the
# compositor (wayland-wm@.service.d/doxia-setup.conf), whose 30 s start
# timeout would not cover it.
[Unit]
Description=DoxIA: set up this account
After=graphical-session-pre.target
Before=graphical-session.target
ConditionPathExists=!%h/.local/state/doxia/setup-done

[Service]
Type=oneshot
ExecStart=/usr/share/doxia/lib/setup-screen
TimeoutStartSec=20min

[Install]
WantedBy=graphical-session-pre.target
